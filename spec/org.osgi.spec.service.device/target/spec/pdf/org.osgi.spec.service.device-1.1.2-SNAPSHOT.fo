         <fo:block id="cmpn.book">
            <fo:block>
               <fo:block>
                  <fo:block-container xmlns:d="http://docbook.org/ns/docbook"
                                      xmlns:xlink="http://www.w3.org/1999/xlink"
                                      absolute-position="absolute"
                                      width="5.54in"
                                      height="3.75in"
                                      top="-0.3in"
                                      left="-0.22in"
                                      background-color="#808080">
                     <fo:block/>
                  </fo:block-container>
                  <fo:block-container xmlns:d="http://docbook.org/ns/docbook"
                                      xmlns:xlink="http://www.w3.org/1999/xlink"
                                      absolute-position="absolute"
                                      width="4.25in"
                                      height="1.4in"
                                      top="-0.3in + 2.92in"
                                      left="-0.22in + 1.29in"
                                      background-color="#004370">
                     <fo:block margin-left="0pt" padding="0.2in">
                        <fo:block text-align="start"
                                  font-family="ProductusSemibold,ArialUnicodeMS"
                                  font-size="18pt"
                                  line-height="26pt"
                                  font-style="normal"
                                  color="white">OSGi Working Group</fo:block>
                        <fo:block text-align="start"
                                  font-family="ProductusSemibold,ArialUnicodeMS"
                                  font-size="24pt"
                                  line-height="26pt"
                                  font-style="normal"
                                  color="white">OSGi Specification repo for org.osgi.service.deviceRelease 1.1.2-SNAPSHOT</fo:block>
                     </fo:block>
                  </fo:block-container>
                  <fo:block-container xmlns:d="http://docbook.org/ns/docbook"
                                      xmlns:xlink="http://www.w3.org/1999/xlink"
                                      absolute-position="absolute"
                                      width="4.25in"
                                      height="0.9in"
                                      top="-0.3in + 2.92in + 1.4in"
                                      left="-0.22in + 1.29in"
                                      display-align="center">
                     <fo:block margin-left="0.2in">
                        <fo:block padding-left="0.2in"
                                  text-align="start"
                                  font-family="ProductusSemibold,ArialUnicodeMS"
                                  font-size="18pt"
                                  line-height="18pt"
                                  font-style="normal"
                                  color="black">
                           <fo:block/>September 2026</fo:block>
                     </fo:block>
