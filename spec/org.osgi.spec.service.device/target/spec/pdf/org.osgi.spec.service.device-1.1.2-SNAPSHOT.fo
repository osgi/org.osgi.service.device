      <fo:flow flow-name="xsl-region-body" start-indent="1in" end-indent="0pt">
         <fo:block id="service.device">
            <fo:block font-family="ProductusSemibold,ArialUnicodeMS">
               <fo:block margin-left="0pt">
                  <fo:block font-size="24.8832pt" font-weight="bold">
                     <fo:block xmlns:d="http://docbook.org/ns/docbook"
                               xmlns:xlink="http://www.w3.org/1999/xlink"
                               keep-with-next.within-column="always"
                               space-before.optimum="0in"
                               space-before.minimum="0in"
                               space-before.maximum="0in"
                               hyphenate="false"
                               text-align="start"
                               start-indent="0pt"
                               font-family="ProductusSemibold,ArialUnicodeMS"
                               font-size="28pt"
                               line-height="35pt"
                               font-weight="normal"
                               space-after="24pt">
                        <fo:list-block provisional-distance-between-starts="1in"
                                       provisional-label-separation="0.090in">
                           <fo:list-item>
                              <fo:list-item-label end-indent="label-end()" text-align="start">
                                 <fo:block>103</fo:block>
                              </fo:list-item-label>
                              <fo:list-item-body start-indent="body-start()">
                                 <fo:block>Device Access Specification</fo:block>
                              </fo:list-item-body>
                           </fo:list-item>
                        </fo:list-block>
                     </fo:block>
                  </fo:block>
                  <fo:block>
                     <fo:block xmlns:d="http://docbook.org/ns/docbook"
                               xmlns:xlink="http://www.w3.org/1999/xlink"
                               font-family="ProductusOSGiBookcItalic"
                               font-size="18pt"
                               line-height="25pt">
                        <fo:basic-link internal-destination="org.osgi.service.device">
                           <fo:inline color="inherit"
                                      font-family="inherit"
                                      letter-spacing="inherit"
                                      hyphenate="inherit">Version 1.1</fo:inline>
                        </fo:basic-link>
                     </fo:block>
                  </fo:block>
               </fo:block>
            </fo:block>
         </fo:block>
         <fo:block id="d121e87">
            <fo:block>
               <fo:block>
                  <fo:block keep-together.within-column="always"
                            margin-left="0pt"
                            font-family="ProductusSemibold,ArialUnicodeMS">
                     <fo:block keep-with-next.within-column="always">
                        <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                  xmlns:xlink="http://www.w3.org/1999/xlink"
                                  font-family="ProductusSemibold,ArialUnicodeMS"
                                  font-weight="normal"
                                  keep-with-next.within-column="always"
                                  space-before.minimum="0.8em"
                                  space-before.optimum="1.0em"
                                  space-before.maximum="1.2em"
                                  text-align="start"
                                  start-indent="0pt"
                                  hyphenate="false">
                           <fo:marker marker-class-name="section.head.marker">Introduction</fo:marker>
                           <fo:block font-size="18pt"
                                     line-height="25pt"
                                     space-before="12.5pt"
                                     space-after="12pt">
                              <fo:list-block provisional-distance-between-starts="1in"
                                             provisional-label-separation="0.090in">
                                 <fo:list-item>
                                    <fo:list-item-label end-indent="label-end()" text-align="start">
                                       <fo:block>103.1</fo:block>
                                    </fo:list-item-label>
                                    <fo:list-item-body start-indent="body-start()">
                                       <fo:block>Introduction</fo:block>
                                    </fo:list-item-body>
                                 </fo:list-item>
                              </fo:list-block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
            </fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">A Framework is a meeting point for services and devices from many
    different vendors: a meeting point where users add and cancel service
    subscriptions, newly installed services find their corresponding input and
    output devices, and device drivers connect to their hardware.</fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">In an OSGi Framework, these activities will dynamically take place
    while the Framework is running. Technologies such as USB and IEEE 1394
    explicitly support plugging and unplugging devices at any time, and
    wireless technologies are even more dynamic.</fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">This flexibility makes it hard to configure all aspects of an OSGi
    Framework, particularly those relating to devices. When all of the
    possible services and device requirements are factored in, each OSGi
    Framework will be unique. Therefore, automated mechanisms are needed that
    can be extended and customized, in order to minimize the configuration
    needs of the OSGi environment.</fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">The Device Access specification supports the coordination of
    automatic detection and attachment of existing devices on an OSGi
    Framework, facilitates hot-plugging and -unplugging of new devices, and
    downloads and installs device drivers on demand.</fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">This specification, however, deliberately does not prescribe any
    particular device or network technology, and mentioned technologies are
    used as examples only. Nor does it specify a particular device discovery
    method. Rather, this specification focuses on the attachment of devices
    supplied by different vendors. It emphasizes the development of
    standardized device interfaces to be defined in device categories,
    although no such device categories are defined in this
    specification.</fo:block>
            <fo:block id="d121e94">
               <fo:block>
                  <fo:block>
                     <fo:block keep-together.within-column="always"
                               margin-left="0pt"
                               font-family="ProductusSemibold,ArialUnicodeMS">
                        <fo:block keep-with-next.within-column="always">
                           <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                     xmlns:xlink="http://www.w3.org/1999/xlink"
                                     font-family="ProductusSemibold,ArialUnicodeMS"
                                     font-weight="normal"
                                     keep-with-next.within-column="always"
                                     space-before.minimum="0.8em"
                                     space-before.optimum="1.0em"
                                     space-before.maximum="1.2em"
                                     text-align="start"
                                     start-indent="0pt"
                                     hyphenate="false">
                              <fo:block font-size="12pt"
                                        line-height="14pt"
                                        space-before="8pt"
                                        space-after="5pt">
                                 <fo:list-block provisional-distance-between-starts="1in"
                                                provisional-label-separation="0.090in">
                                    <fo:list-item>
                                       <fo:list-item-label end-indent="label-end()" text-align="start">
                                          <fo:block>103.1.1</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>Essentials</fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                 </fo:list-block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
               <fo:list-block space-before.optimum="1em"
                              space-before.minimum="0.8em"
                              space-before.maximum="1.2em"
                              space-after.optimum="1em"
                              space-after.minimum="0.8em"
                              space-after.maximum="1.2em"
                              provisional-label-separation="0.2em"
                              provisional-distance-between-starts="12pt"
                              id="d121e96">
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d121e97">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-style="italic">Embedded Devices</fo:inline> - OSGi bundles will
          likely run in embedded devices. This environment implies limited
          possibility for user interaction, and low-end devices will probably
          have resource limitations.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d121e101">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-style="italic">Remote Administration</fo:inline> - OSGi environments
          must support administration by a remote service provider.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d121e105">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-style="italic">Vendor Neutrality</fo:inline> - OSGi-compliant driver
          bundles will be supplied by different vendors; each driver bundle
          must be well-defined, documented, and replaceable.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d121e109">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-style="italic">Continuous Operation</fo:inline> - OSGi environments
          will be running for extended periods without being restarted,
          possibly continuously, requiring stable operation and stable
          resource consumption.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d121e113">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-style="italic">Dynamic Updates</fo:inline> - As much as possible,
          driver bundles must be individually replaceable without affecting
          unrelated bundles. In particular, the process of updating a bundle
          should not require a restart of the whole OSGi Framework or disrupt
          operation of connected devices.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
               </fo:list-block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">A number of requirements must be satisfied by Device Access
      implementations in order for them to be OSGi-compliant. Implementations
      must support the following capabilities:</fo:block>
               <fo:list-block space-before.optimum="1em"
                              space-before.minimum="0.8em"
                              space-before.maximum="1.2em"
                              space-after.optimum="1em"
                              space-after.minimum="0.8em"
                              space-after.maximum="1.2em"
                              provisional-label-separation="0.2em"
                              provisional-distance-between-starts="12pt"
                              id="d121e118">
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d121e119">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-style="italic">Hot-Plugging</fo:inline> - Plugging and unplugging of
          devices at any time if the underlying hardware and drivers allow
          it.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d121e123">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-style="italic">Legacy Systems</fo:inline> - Device technologies
          which do not implement the automatic detection of plugged and
          unplugged devices.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d121e127">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-style="italic">Dynamic Device Driver Loading</fo:inline> - Loading
          new driver bundles on demand with no prior device-specific knowledge
          of the Device service.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d121e131">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-style="italic">Multiple Device Representations</fo:inline> - Devices
          to be accessed from multiple levels of abstraction.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d121e135">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-style="italic">Deep Trees</fo:inline> - Connections of devices in a
          tree of mixed network technologies of arbitrary depth.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d121e139">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-style="italic">Topology Independence</fo:inline> - Separation of the
          interfaces of a device from where and how it is attached.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d121e143">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-style="italic">Complex Devices</fo:inline> - Multifunction devices
          and devices that have multiple configurations.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
               </fo:list-block>
            </fo:block>
            <fo:block id="d121e147">
               <fo:block>
                  <fo:block>
                     <fo:block keep-together.within-column="always"
                               margin-left="0pt"
                               font-family="ProductusSemibold,ArialUnicodeMS">
                        <fo:block keep-with-next.within-column="always">
                           <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                     xmlns:xlink="http://www.w3.org/1999/xlink"
                                     font-family="ProductusSemibold,ArialUnicodeMS"
                                     font-weight="normal"
                                     keep-with-next.within-column="always"
                                     space-before.minimum="0.8em"
                                     space-before.optimum="1.0em"
                                     space-before.maximum="1.2em"
                                     text-align="start"
                                     start-indent="0pt"
                                     hyphenate="false">
                              <fo:block font-size="12pt"
                                        line-height="14pt"
                                        space-before="8pt"
                                        space-after="5pt">
                                 <fo:list-block provisional-distance-between-starts="1in"
                                                provisional-label-separation="0.090in">
                                    <fo:list-item>
                                       <fo:list-item-label end-indent="label-end()" text-align="start">
                                          <fo:block>103.1.2</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>Operation</fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                 </fo:list-block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">This specification defines the behavior of a device manager (which
      is <fo:inline font-style="italic">not</fo:inline> a service as might be expected). This device
      manager detects registration of Device services and is responsible for
      associating these devices with an appropriate Driver service. These
      tasks are done with the help of Driver Locator services and the Driver
      Selector service that allow a device manager to find a Driver bundle and
      install it.</fo:block>
            </fo:block>
            <fo:block id="d121e153">
               <fo:block>
                  <fo:block>
                     <fo:block keep-together.within-column="always"
                               margin-left="0pt"
                               font-family="ProductusSemibold,ArialUnicodeMS">
                        <fo:block keep-with-next.within-column="always">
                           <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                     xmlns:xlink="http://www.w3.org/1999/xlink"
                                     font-family="ProductusSemibold,ArialUnicodeMS"
                                     font-weight="normal"
                                     keep-with-next.within-column="always"
                                     space-before.minimum="0.8em"
                                     space-before.optimum="1.0em"
                                     space-before.maximum="1.2em"
                                     text-align="start"
                                     start-indent="0pt"
                                     hyphenate="false">
                              <fo:block font-size="12pt"
                                        line-height="14pt"
                                        space-before="8pt"
                                        space-after="5pt">
                                 <fo:list-block provisional-distance-between-starts="1in"
                                                provisional-label-separation="0.090in">
                                    <fo:list-item>
                                       <fo:list-item-label end-indent="label-end()" text-align="start">
                                          <fo:block>103.1.3</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>Entities</fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                 </fo:list-block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">The main entities of the Device Access specification are:</fo:block>
               <fo:list-block space-before.optimum="1em"
                              space-before.minimum="0.8em"
                              space-before.maximum="1.2em"
                              space-after.optimum="1em"
                              space-after.minimum="0.8em"
                              space-after.maximum="1.2em"
                              provisional-label-separation="0.2em"
                              provisional-distance-between-starts="12pt"
                              id="d121e156">
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d121e157">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-style="italic">Device Manager</fo:inline> - The bundle that controls
          the initiation of the attachment process behind the scenes.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d121e161">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-style="italic">Device Category</fo:inline> - Defines how a Driver
          service and a Device service can cooperate.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d121e165">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-style="italic">Driver</fo:inline> - Competes for attaching Device
          services of its recognized device category. See <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                             xmlns:xlink="http://www.w3.org/1999/xlink"
                                             internal-destination="i1282334">
                                 <fo:inline color="inherit"
                                            font-family="inherit"
                                            letter-spacing="inherit"
                                            hyphenate="inherit">
                                    <fo:inline font-style="italic">Driver Services</fo:inline> on page <fo:page-number-citation ref-id="i1282334"/>
                                 </fo:inline>
                              </fo:basic-link>.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d121e171">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-style="italic">Device</fo:inline> - A representation of a physical
          device or other entity that can be attached by a Driver service. See
          <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                             xmlns:xlink="http://www.w3.org/1999/xlink"
                                             internal-destination="i1292342">
                                 <fo:inline color="inherit"
                                            font-family="inherit"
                                            letter-spacing="inherit"
                                            hyphenate="inherit">
                                    <fo:inline font-style="italic">Device Services</fo:inline> on page <fo:page-number-citation ref-id="i1292342"/>
                                 </fo:inline>
                              </fo:basic-link>.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d121e177">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-style="italic">DriverLocator</fo:inline> - Assists in locating
          bundles that provide a Driver service. See <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                             xmlns:xlink="http://www.w3.org/1999/xlink"
                                             internal-destination="i1292350">
                                 <fo:inline color="inherit"
                                            font-family="inherit"
                                            letter-spacing="inherit"
                                            hyphenate="inherit">
                                    <fo:inline font-style="italic">Driver Locator Service</fo:inline> on page <fo:page-number-citation ref-id="i1292350"/>
                                 </fo:inline>
                              </fo:basic-link>.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d121e183">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-style="italic">DriverSelector</fo:inline> - Assists in selecting
          which Driver service is best suited to a Device service. See <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                             xmlns:xlink="http://www.w3.org/1999/xlink"
                                             internal-destination="i1286950">
                                 <fo:inline color="inherit"
                                            font-family="inherit"
                                            letter-spacing="inherit"
                                            hyphenate="inherit">
                                    <fo:inline font-style="italic">The Driver Selector Service</fo:inline> on page <fo:page-number-citation ref-id="i1286950"/>
                                 </fo:inline>
                              </fo:basic-link>.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
               </fo:list-block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">
                  <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                 xmlns:xlink="http://www.w3.org/1999/xlink"
                                 internal-destination="i1309251">
                     <fo:inline color="inherit"
                                font-family="inherit"
                                letter-spacing="inherit"
                                hyphenate="inherit">Figure 103.1</fo:inline>
                  </fo:basic-link> show the classes and their
      relationships.</fo:block>
               <fo:block start-indent="0pt">
                  <fo:block space-before.minimum="0.5em"
                            space-before.optimum="1em"
                            space-before.maximum="2em"
                            space-after.minimum="0.5em"
                            space-after.optimum="1em"
                            space-after.maximum="2em"
                            keep-together.within-column="always"
                            id="i1309251">
                     <fo:block xmlns:d="http://docbook.org/ns/docbook"
                               xmlns:xlink="http://www.w3.org/1999/xlink"
                               space-before.optimum="5pt"
                               space-before.minimum="5pt"
                               space-before.maximum="5pt"
                               font-weight="normal"
                               font-size="9pt"
                               hyphenate="false"
                               space-after.minimum="0.4em"
                               space-after.optimum="0.6em"
                               space-after.maximum="0.8em"
                               start-indent="0pt"
                               font-family="Proforma-Book,ArialUnicodeMS"
                               font-style="italic"
                               keep-with-next.within-column="always">
                        <fo:list-block provisional-distance-between-starts="1in"
                                       provisional-label-separation="0.090in">
                           <fo:list-item>
                              <fo:list-item-label end-indent="label-end()" text-align="start">
                                 <fo:block>Figure 103.1</fo:block>
                              </fo:list-item-label>
                              <fo:list-item-body start-indent="body-start()">
                                 <fo:block>Device Access Class Overview</fo:block>
                              </fo:list-item-body>
                           </fo:list-item>
                        </fo:list-block>
                     </fo:block>
                     <fo:block id="d121e194" text-align="center">
                        <fo:external-graphic src="url(file:///home/stbischof/git/OSGI_MIGRATE/osgi_target/org.osgi.service.device/spec/org.osgi.spec.service.device/src/main/resources/spec/device-classes.svg)"
                                             width="auto"
                                             height="auto"
                                             content-width="7.000in"
                                             content-height="4.444in"
                                             text-align="center"/>
                     </fo:block>
                  </fo:block>
               </fo:block>
            </fo:block>
         </fo:block>
         <fo:block id="i1292342">
            <fo:block>
               <fo:block>
                  <fo:block keep-together.within-column="always"
                            margin-left="0pt"
                            font-family="ProductusSemibold,ArialUnicodeMS">
                     <fo:block keep-with-next.within-column="always">
                        <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                  xmlns:xlink="http://www.w3.org/1999/xlink"
                                  font-family="ProductusSemibold,ArialUnicodeMS"
                                  font-weight="normal"
                                  keep-with-next.within-column="always"
                                  space-before.minimum="0.8em"
                                  space-before.optimum="1.0em"
                                  space-before.maximum="1.2em"
                                  text-align="start"
                                  start-indent="0pt"
                                  hyphenate="false">
                           <fo:marker marker-class-name="section.head.marker">Device Services</fo:marker>
                           <fo:block font-size="18pt"
                                     line-height="25pt"
                                     space-before="12.5pt"
                                     space-after="12pt">
                              <fo:list-block provisional-distance-between-starts="1in"
                                             provisional-label-separation="0.090in">
                                 <fo:list-item>
                                    <fo:list-item-label end-indent="label-end()" text-align="start">
                                       <fo:block>103.2</fo:block>
                                    </fo:list-item-label>
                                    <fo:list-item-body start-indent="body-start()">
                                       <fo:block>Device Services</fo:block>
                                    </fo:list-item-body>
                                 </fo:list-item>
                              </fo:list-block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
            </fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">A Device service represents some form of a device. It can represent
    a hardware device, but that is not a requirement. Device services differ
    widely: some represent individual physical devices and others represent
    complete networks. Several Device services can even simultaneously
    represent the same physical device at different levels of abstraction. For
    example:</fo:block>
            <fo:list-block space-before.optimum="1em"
                           space-before.minimum="0.8em"
                           space-before.maximum="1.2em"
                           space-after.optimum="1em"
                           space-after.minimum="0.8em"
                           space-after.maximum="1.2em"
                           provisional-label-separation="0.2em"
                           provisional-distance-between-starts="12pt"
                           id="d121e200">
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d121e201">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>A USB network.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d121e203">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>A device attached on the USB network.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d121e205">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>The same device recognized as a USB to Ethernet bridge.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d121e207">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>A device discovered on the Ethernet using Salutation.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d121e209">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>The same device recognized as a simple printer.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d121e211">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>The same printer refined to a PostScript printer.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
            </fo:list-block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">A device can also be represented in different ways. For example, a
    USB mouse can be considered as:</fo:block>
            <fo:list-block space-before.optimum="1em"
                           space-before.minimum="0.8em"
                           space-before.maximum="1.2em"
                           space-after.optimum="1em"
                           space-after.minimum="0.8em"
                           space-after.maximum="1.2em"
                           provisional-label-separation="0.2em"
                           provisional-distance-between-starts="12pt"
                           id="d121e214">
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d121e215">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>A USB device which delivers information over the USB bus.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d121e217">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>A mouse device which delivers <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                      font-size="9pt"
                                      letter-spacing="0.08em">x</fo:inline> and <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                      font-size="9pt"
                                      letter-spacing="0.08em">y</fo:inline>
        coordinates and information about the state of its buttons.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
            </fo:list-block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">Each representation has specific implications:</fo:block>
            <fo:list-block space-before.optimum="1em"
                           space-before.minimum="0.8em"
                           space-before.maximum="1.2em"
                           space-after.optimum="1em"
                           space-after.minimum="0.8em"
                           space-after.maximum="1.2em"
                           provisional-label-separation="0.2em"
                           provisional-distance-between-starts="12pt"
                           id="d121e225">
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d121e226">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>That a particular device is a mouse is irrelevant to an
        application which provides management of USB devices.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d121e228">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>That a mouse is attached to a USB bus or a serial port would be
        inconsequential to applications that respond to mouse-like
        input.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
            </fo:list-block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">Device services must belong to a defined <fo:inline font-style="italic">device
    category</fo:inline>, or else they can implement a generic service which
    models a particular device, independent of its underlying technology.
    Examples of this type of implementation could be Sensor or Actuator
    services.</fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">A device category specifies the methods for communicating with a
    Device service, and enables interoperability between bundles that are
    based on the same underlying technology. Generic Device services will
    allow interoperability between bundles that are not coupled to specific
    device technologies.</fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">For example, a device category is required for the USB, so that
    Driver bundles can be written that communicate to the devices that are
    attached to the USB. If a printer is attached, it should also be available
    as a generic Printer service defined in a Printer service specification,
    indistinguishable from a Printer service attached to a parallel port.
    Generic categories, such as a Printer service, should also be described in
    a Device Category.</fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">It is expected that most Device service objects will actually
    represent a physical device in some form, but that is not a requirement of
    this specification. A Device service is represented as a normal service in
    the OSGi Framework and all coordination and activities are performed upon
    Framework services. This specification does not limit a bundle developer
    from using Framework mechanisms for services that are not related to
    physical devices.</fo:block>
            <fo:block id="service.device-device.service.registration">
               <fo:block>
                  <fo:block>
                     <fo:block keep-together.within-column="always"
                               margin-left="0pt"
                               font-family="ProductusSemibold,ArialUnicodeMS">
                        <fo:block keep-with-next.within-column="always">
                           <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                     xmlns:xlink="http://www.w3.org/1999/xlink"
                                     font-family="ProductusSemibold,ArialUnicodeMS"
                                     font-weight="normal"
                                     keep-with-next.within-column="always"
                                     space-before.minimum="0.8em"
                                     space-before.optimum="1.0em"
                                     space-before.maximum="1.2em"
                                     text-align="start"
                                     start-indent="0pt"
                                     hyphenate="false">
                              <fo:block font-size="12pt"
                                        line-height="14pt"
                                        space-before="8pt"
                                        space-after="5pt">
                                 <fo:list-block provisional-distance-between-starts="1in"
                                                provisional-label-separation="0.090in">
                                    <fo:list-item>
                                       <fo:list-item-label end-indent="label-end()" text-align="start">
                                          <fo:block>103.2.1</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>Device Service Registration</fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                 </fo:list-block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">A Device service is defined as a normal service registered with
      the Framework that either:</fo:block>
               <fo:list-block space-before.optimum="1em"
                              space-before.minimum="0.8em"
                              space-before.maximum="1.2em"
                              space-after.optimum="1em"
                              space-after.minimum="0.8em"
                              space-after.maximum="1.2em"
                              provisional-label-separation="0.2em"
                              provisional-distance-between-starts="12pt"
                              id="d121e241">
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d121e242">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>Registers a service object under the interface
          <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">org.osgi.service.Device</fo:inline> with the Framework, or</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d121e247">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>Sets the <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                             xmlns:xlink="http://www.w3.org/1999/xlink"
                                             internal-destination="org.osgi.service.device.Constants.DEVICE_CATEGORY">
                                 <fo:inline color="blue"
                                            font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            letter-spacing="0.08em"
                                            hyphenate="false">DEVICE_CATEGORY</fo:inline>
                              </fo:basic-link> property in the registration. The value of
          <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">DEVICE_CATEGORY</fo:inline> is an array of <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">String</fo:inline>
          objects of all the device categories that the device belongs to.
          These strings are defined in the associated device category.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
               </fo:list-block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">If this document mentions a Device service, it is meant to refer
      to services registered with the name
      <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">org.osgi.service.device.Device</fo:inline>
                  <fo:inline font-style="italic">or</fo:inline>
      services registered with the <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">DEVICE_CATEGORY</fo:inline> property
      set.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">When a Device service is registered, additional properties may be
      set that describe the device to the device manager and potentially to
      the end users. The following properties have their semantics defined in
      this specification:</fo:block>
               <fo:list-block space-before.optimum="1em"
                              space-before.minimum="0.8em"
                              space-before.maximum="1.2em"
                              space-after.optimum="1em"
                              space-after.minimum="0.8em"
                              space-after.maximum="1.2em"
                              provisional-label-separation="0.2em"
                              provisional-distance-between-starts="12pt"
                              id="d121e265">
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d121e266">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                             xmlns:xlink="http://www.w3.org/1999/xlink"
                                             internal-destination="org.osgi.service.device.Constants.DEVICE_CATEGORY">
                                 <fo:inline color="blue"
                                            font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            letter-spacing="0.08em"
                                            hyphenate="false">DEVICE_CATEGORY</fo:inline>
                              </fo:basic-link> - A marker property indicating that this
          service must be regarded as a Device service by the device manager.
          Its value is of type <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">String[]</fo:inline>, and its meaning is
          defined in the associated device category specification.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d121e272">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                             xmlns:xlink="http://www.w3.org/1999/xlink"
                                             internal-destination="org.osgi.service.device.Constants.DEVICE_DESCRIPTION">
                                 <fo:inline color="blue"
                                            font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            letter-spacing="0.08em"
                                            hyphenate="false">DEVICE_DESCRIPTION</fo:inline>
                              </fo:basic-link> - Describes the device to an end user. Its
          value is of type <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">String</fo:inline>.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d121e278">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                             xmlns:xlink="http://www.w3.org/1999/xlink"
                                             internal-destination="org.osgi.service.device.Constants.DEVICE_SERIAL">
                                 <fo:inline color="blue"
                                            font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            letter-spacing="0.08em"
                                            hyphenate="false">DEVICE_SERIAL</fo:inline>
                              </fo:basic-link> - A unique serial number for this device. If
          the device hardware contains a serial number, the driver bundle is
          encouraged to specify it as this property. Different Device services
          representing the same physical hardware at different abstraction
          levels should set the same <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">DEVICE_SERIAL</fo:inline>, thus
          simplifying identification. Its value is of type
          <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">String</fo:inline>.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d121e286">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">service.pid</fo:inline> - Service Persistent ID (PID),
          defined in <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">org.osgi.framework.Constants</fo:inline>. Device
          services should set this property. It must be unique among all
          registered services. Even different abstraction levels of the same
          device must use different PIDs. The service PIDs must be
          reproducible, so that every time the same hardware is plugged in,
          the same PIDs are used.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
               </fo:list-block>
            </fo:block>
            <fo:block id="d121e292">
               <fo:block>
                  <fo:block>
                     <fo:block keep-together.within-column="always"
                               margin-left="0pt"
                               font-family="ProductusSemibold,ArialUnicodeMS">
                        <fo:block keep-with-next.within-column="always">
                           <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                     xmlns:xlink="http://www.w3.org/1999/xlink"
                                     font-family="ProductusSemibold,ArialUnicodeMS"
                                     font-weight="normal"
                                     keep-with-next.within-column="always"
                                     space-before.minimum="0.8em"
                                     space-before.optimum="1.0em"
                                     space-before.maximum="1.2em"
                                     text-align="start"
                                     start-indent="0pt"
                                     hyphenate="false">
                              <fo:block font-size="12pt"
                                        line-height="14pt"
                                        space-before="8pt"
                                        space-after="5pt">
                                 <fo:list-block provisional-distance-between-starts="1in"
                                                provisional-label-separation="0.090in">
                                    <fo:list-item>
                                       <fo:list-item-label end-indent="label-end()" text-align="start">
                                          <fo:block>103.2.2</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>Device Service Attachment</fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                 </fo:list-block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">When a Device service is registered with the Framework, the device
      manager is responsible for finding a suitable Driver service and
      instructing it to attach to the newly registered Device service. The
      Device service itself is passive: it only registers a Device service
      with the Framework and then waits until it is called.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">The actual communication with the underlying physical device is
      not defined in the <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">Device</fo:inline> interface because it differs
      significantly between different types of devices. The Driver service is
      responsible for attaching the device in a device type-specific manner.
      The rules and interfaces for this process must be defined in the
      appropriate device category.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">If the device manager is unable to find a suitable Driver service,
      the Device service remains unattached. In that case, if the service
      object implements the <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">Device</fo:inline> interface, it must receive a
      call to the <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                 xmlns:xlink="http://www.w3.org/1999/xlink"
                                 internal-destination="org.osgi.service.device.Device.noDriverFound--">
                     <fo:inline color="blue"
                                font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                letter-spacing="0.08em"
                                hyphenate="false">noDriverFound()</fo:inline>
                  </fo:basic-link> method. The Device service can wait until a new
      driver is installed, or it can unregister and attempt to register again
      with different properties that describe a more generic device or try a
      different configuration.</fo:block>
               <fo:block id="d121e305">
                  <fo:block>
                     <fo:block>
                        <fo:block keep-together.within-column="always"
                                  margin-left="0pt"
                                  font-family="ProductusSemibold,ArialUnicodeMS">
                           <fo:block keep-with-next.within-column="always">
                              <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                        xmlns:xlink="http://www.w3.org/1999/xlink"
                                        font-family="ProductusSemibold,ArialUnicodeMS"
                                        font-weight="normal"
                                        keep-with-next.within-column="always"
                                        space-before.minimum="0.8em"
                                        space-before.optimum="1.0em"
                                        space-before.maximum="1.2em"
                                        text-align="start"
                                        start-indent="0pt"
                                        hyphenate="false">
                                 <fo:block font-size="9pt"
                                           line-height="11pt"
                                           space-before="5pt"
                                           space-after="5pt">
                                    <fo:list-block provisional-distance-between-starts="1in"
                                                   provisional-label-separation="0.090in">
                                       <fo:list-item>
                                          <fo:list-item-label end-indent="label-end()" text-align="start">
                                             <fo:block>103.2.2.1</fo:block>
                                          </fo:list-item-label>
                                          <fo:list-item-body start-indent="body-start()">
                                             <fo:block>Idle Device Service</fo:block>
                                          </fo:list-item-body>
                                       </fo:list-item>
                                    </fo:list-block>
                                 </fo:block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
                  <fo:block space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt">The main purpose of the device manager is to try to attach
        drivers to idle devices. For this purpose, a Device service is
        considered <fo:inline font-style="italic">idle</fo:inline> if no bundle that itself has
        registered a Driver service is using the Device service.</fo:block>
               </fo:block>
               <fo:block id="d121e311">
                  <fo:block>
                     <fo:block>
                        <fo:block keep-together.within-column="always"
                                  margin-left="0pt"
                                  font-family="ProductusSemibold,ArialUnicodeMS">
                           <fo:block keep-with-next.within-column="always">
                              <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                        xmlns:xlink="http://www.w3.org/1999/xlink"
                                        font-family="ProductusSemibold,ArialUnicodeMS"
                                        font-weight="normal"
                                        keep-with-next.within-column="always"
                                        space-before.minimum="0.8em"
                                        space-before.optimum="1.0em"
                                        space-before.maximum="1.2em"
                                        text-align="start"
                                        start-indent="0pt"
                                        hyphenate="false">
                                 <fo:block font-size="9pt"
                                           line-height="11pt"
                                           space-before="5pt"
                                           space-after="5pt">
                                    <fo:list-block provisional-distance-between-starts="1in"
                                                   provisional-label-separation="0.090in">
                                       <fo:list-item>
                                          <fo:list-item-label end-indent="label-end()" text-align="start">
                                             <fo:block>103.2.2.2</fo:block>
                                          </fo:list-item-label>
                                          <fo:list-item-body start-indent="body-start()">
                                             <fo:block>Device Service Unregistration</fo:block>
                                          </fo:list-item-body>
                                       </fo:list-item>
                                    </fo:list-block>
                                 </fo:block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
                  <fo:block space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt">When a Device service is unregistered, no immediate action is
        required by the device manager. The normal service of unregistering
        events, provided by the Framework, takes care of propagating the
        unregistration information to affected drivers. Drivers must take the
        appropriate action to release this Device service and perform any
        necessary cleanup, as described in their device category
        specification.</fo:block>
                  <fo:block space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt">The device manager may, however, take a device unregistration as
        an indication that driver bundles may have become idle and are thus
        eligible for removal. It is therefore important for Device services to
        unregister their service object when the underlying entity becomes
        unavailable.</fo:block>
               </fo:block>
            </fo:block>
         </fo:block>
         <fo:block id="service.device-device.category">
            <fo:block>
               <fo:block>
                  <fo:block keep-together.within-column="always"
                            margin-left="0pt"
                            font-family="ProductusSemibold,ArialUnicodeMS">
                     <fo:block keep-with-next.within-column="always">
                        <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                  xmlns:xlink="http://www.w3.org/1999/xlink"
                                  font-family="ProductusSemibold,ArialUnicodeMS"
                                  font-weight="normal"
                                  keep-with-next.within-column="always"
                                  space-before.minimum="0.8em"
                                  space-before.optimum="1.0em"
                                  space-before.maximum="1.2em"
                                  text-align="start"
                                  start-indent="0pt"
                                  hyphenate="false">
                           <fo:marker marker-class-name="section.head.marker">Device Category Specifications</fo:marker>
                           <fo:block font-size="18pt"
                                     line-height="25pt"
                                     space-before="12.5pt"
                                     space-after="12pt">
                              <fo:list-block provisional-distance-between-starts="1in"
                                             provisional-label-separation="0.090in">
                                 <fo:list-item>
                                    <fo:list-item-label end-indent="label-end()" text-align="start">
                                       <fo:block>103.3</fo:block>
                                    </fo:list-item-label>
                                    <fo:list-item-body start-indent="body-start()">
                                       <fo:block>Device Category Specifications</fo:block>
                                    </fo:list-item-body>
                                 </fo:list-item>
                              </fo:list-block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
            </fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">A device category specifies the rules and interfaces needed for the
    communication between a Device service and a Driver service. Only Device
    services and Driver services of the same device category can communicate
    and cooperate.</fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">The Device Access service specification is limited to the attachment
    of Device services by Driver services, and does <fo:inline font-style="italic">not</fo:inline>
    enumerate different device categories.</fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">Other specifications must specify a number of device categories
    before this specification can be made operational. Without a set of
    defined device categories, no interoperability can be achieved.</fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">Device categories are related to a specific device technology, such
    as USB, IEEE 1394, JINI, UPnP, Salutation, CEBus, Lonworks, and others.
    The purpose of a device category specification is to make all Device
    services of that category conform to an agreed interface, so that, for
    example, a USB Driver service of vendor A can control Device services from
    vendor B attached to a USB bus.</fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">This specification is limited to defining the guidelines for device
    category definitions only. Device categories may be defined by the OSGi
    organization or by external specification bodies - for example, when these
    bodies are associated with a specific device technology.</fo:block>
            <fo:block id="d121e325">
               <fo:block>
                  <fo:block>
                     <fo:block keep-together.within-column="always"
                               margin-left="0pt"
                               font-family="ProductusSemibold,ArialUnicodeMS">
                        <fo:block keep-with-next.within-column="always">
                           <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                     xmlns:xlink="http://www.w3.org/1999/xlink"
                                     font-family="ProductusSemibold,ArialUnicodeMS"
                                     font-weight="normal"
                                     keep-with-next.within-column="always"
                                     space-before.minimum="0.8em"
                                     space-before.optimum="1.0em"
                                     space-before.maximum="1.2em"
                                     text-align="start"
                                     start-indent="0pt"
                                     hyphenate="false">
                              <fo:block font-size="12pt"
                                        line-height="14pt"
                                        space-before="8pt"
                                        space-after="5pt">
                                 <fo:list-block provisional-distance-between-starts="1in"
                                                provisional-label-separation="0.090in">
                                    <fo:list-item>
                                       <fo:list-item-label end-indent="label-end()" text-align="start">
                                          <fo:block>103.3.1</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>Device Category Guidelines</fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                 </fo:list-block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">A device category definition comprises the following
      elements:</fo:block>
               <fo:list-block space-before.optimum="1em"
                              space-before.minimum="0.8em"
                              space-before.maximum="1.2em"
                              space-after.optimum="1em"
                              space-after.minimum="0.8em"
                              space-after.maximum="1.2em"
                              provisional-label-separation="0.2em"
                              provisional-distance-between-starts="12pt"
                              id="d121e328">
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d121e329">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>An interface that all devices belonging to this category must
          implement. This interface should lay out the rules of how to
          communicate with the underlying device. The specification body may
          define its own device interfaces (or classes) or leverage existing
          ones. For example, a serial port device category could use the
          <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">javax.comm.SerialPort</fo:inline> interface which is defined in
          <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                             xmlns:xlink="http://www.w3.org/1999/xlink"
                                             internal-destination="i1424268">
                                 <fo:inline color="inherit"
                                            font-family="inherit"
                                            letter-spacing="inherit"
                                            hyphenate="inherit">[1] <fo:inline font-style="italic">Java Communications API</fo:inline>
                                 </fo:inline>
                              </fo:basic-link>.</fo:block>
                           <fo:block space-before.optimum="5pt"
                                     space-before.minimum="5pt"
                                     space-before.maximum="5pt">When registering a device belonging to this category with the
          Framework, the interface or class name for this category must be
          included in the registration.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d121e337">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>A set of service registration properties, their data types,
          and semantics, each of which must be declared as either
          <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">MANDATORY</fo:inline> or <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">OPTIONAL</fo:inline> for this device
          category.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d121e344">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>A range of match values specific to this device category.
          Matching is explained later in <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                             xmlns:xlink="http://www.w3.org/1999/xlink"
                                             internal-destination="i1288442">
                                 <fo:inline color="inherit"
                                            font-family="inherit"
                                            letter-spacing="inherit"
                                            hyphenate="inherit">
                                    <fo:inline font-style="italic">The Device Attachment Algorithm</fo:inline> on page <fo:page-number-citation ref-id="i1288442"/>
                                 </fo:inline>
                              </fo:basic-link>.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
               </fo:list-block>
            </fo:block>
            <fo:block id="i1306027">
               <fo:block>
                  <fo:block>
                     <fo:block keep-together.within-column="always"
                               margin-left="0pt"
                               font-family="ProductusSemibold,ArialUnicodeMS">
                        <fo:block keep-with-next.within-column="always">
                           <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                     xmlns:xlink="http://www.w3.org/1999/xlink"
                                     font-family="ProductusSemibold,ArialUnicodeMS"
                                     font-weight="normal"
                                     keep-with-next.within-column="always"
                                     space-before.minimum="0.8em"
                                     space-before.optimum="1.0em"
                                     space-before.maximum="1.2em"
                                     text-align="start"
                                     start-indent="0pt"
                                     hyphenate="false">
                              <fo:block font-size="12pt"
                                        line-height="14pt"
                                        space-before="8pt"
                                        space-after="5pt">
                                 <fo:list-block provisional-distance-between-starts="1in"
                                                provisional-label-separation="0.090in">
                                    <fo:list-item>
                                       <fo:list-item-label end-indent="label-end()" text-align="start">
                                          <fo:block>103.3.2</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>Sample Device Category Specification</fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                 </fo:list-block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">The following is a partial example of a fictitious device
      category:</fo:block>
               <fo:block space-before.minimum="0.8em"
                         space-before.optimum="1em"
                         space-before.maximum="1.2em"
                         space-after.minimum="0.8em"
                         space-after.optimum="1em"
                         space-after.maximum="1.2em"
                         hyphenate="false"
                         wrap-option="no-wrap"
                         white-space-collapse="false"
                         white-space-treatment="preserve"
                         linefeed-treatment="preserve"
                         text-align="start"
                         font-family="ProductusOSGiMonoc,ArialUnicodeMS"
                         font-size="9pt"
                         letter-spacing="-.0em"
                         space-before="5pt"
                         space-after="3pt"
                         space-after.conditionality="retain"
                         start-indent="inherit"
                         line-height="11pt"
                         id="d121e352">public interface /* com.acme.widget.*/ WidgetDevice{
    int MATCH_SERIAL                    = 10;
    int MATCH_VERSION                   =  8;
    int MATCH_MODEL                     =  6;
    int MATCH_MAKE                      =  4;
    int MATCH_CLASS                     =  2;
    void sendPacket( byte [] data );
    byte [] receivePacket( long timeout );
}</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">Devices in this category must implement the interface
      <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">com.acme.widget.WidgetDevice</fo:inline> to receive attachments from
      Driver services in this category.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">Device properties for this fictitious category are defined in the
      following table.</fo:block>
               <fo:block xmlns:rx="http://www.renderx.com/XSL/Extensions"
                         space-before.minimum="0.5em"
                         space-before.optimum="1em"
                         space-before.maximum="2em"
                         space-after.minimum="0.5em"
                         space-after.optimum="1em"
                         space-after.maximum="2em"
                         keep-together.within-column="auto"
                         id="d121e358">
                  <fo:block xmlns:d="http://docbook.org/ns/docbook"
                            xmlns:xlink="http://www.w3.org/1999/xlink"
                            space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt"
                            font-weight="normal"
                            font-size="9pt"
                            hyphenate="false"
                            space-after.minimum="0.4em"
                            space-after.optimum="0.6em"
                            space-after.maximum="0.8em"
                            start-indent="0pt"
                            font-family="Proforma-Book,ArialUnicodeMS"
                            font-style="italic"
                            keep-with-next.within-column="always">
                     <fo:list-block provisional-distance-between-starts="1in"
                                    provisional-label-separation="0.090in">
                        <fo:list-item>
                           <fo:list-item-label end-indent="label-end()" text-align="start">
                              <fo:block>Table 103.1</fo:block>
                           </fo:list-item-label>
                           <fo:list-item-body start-indent="body-start()">
                              <fo:block>Example Device Category Properties, M=Mandatory,
        O=Optional</fo:block>
                           </fo:list-item-body>
                        </fo:list-item>
                     </fo:list-block>
                  </fo:block>
                  <fo:table border-before-width.conditionality="retain"
                            border-collapse="collapse"
                            table-layout="fixed"
                            width="100%">
                     <fo:table-column column-number="1" column-width="proportional-column-width(3)"/>
                     <fo:table-column column-number="2" column-width="proportional-column-width(1)"/>
                     <fo:table-column column-number="3" column-width="proportional-column-width(1.5)"/>
                     <fo:table-column column-number="4" column-width="proportional-column-width(4)"/>
                     <fo:table-header start-indent="0pt" end-indent="0pt">
                        <fo:table-row keep-together.within-column="always"
                                      keep-with-next.within-column="always"
                                      font-family="ProductusSemibold,ArialUnicodeMS">
                           <fo:table-cell padding-start="0pt"
                                          padding-end="4pt"
                                          padding-top="1pt"
                                          padding-bottom="1pt">
                              <fo:block>Property name</fo:block>
                           </fo:table-cell>
                           <fo:table-cell padding-start="0pt"
                                          padding-end="4pt"
                                          padding-top="1pt"
                                          padding-bottom="1pt">
                              <fo:block>M/O</fo:block>
                           </fo:table-cell>
                           <fo:table-cell padding-start="0pt"
                                          padding-end="4pt"
                                          padding-top="1pt"
                                          padding-bottom="1pt">
                              <fo:block>Type</fo:block>
                           </fo:table-cell>
                           <fo:table-cell padding-start="0pt"
                                          padding-end="4pt"
                                          padding-top="1pt"
                                          padding-bottom="1pt">
                              <fo:block>Value</fo:block>
                           </fo:table-cell>
                        </fo:table-row>
                     </fo:table-header>
                     <fo:table-body start-indent="0pt" end-indent="0pt">
                        <fo:table-row keep-together.within-column="always">
                           <fo:table-cell padding-start="0pt"
                                          padding-end="4pt"
                                          padding-top="1pt"
                                          padding-bottom="1pt">
                              <fo:block>
                                 <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">DEVICE_CATEGORY</fo:inline>
                              </fo:block>
                           </fo:table-cell>
                           <fo:table-cell padding-start="0pt"
                                          padding-end="4pt"
                                          padding-top="1pt"
                                          padding-bottom="1pt">
                              <fo:block>
                                 <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">M</fo:inline>
                              </fo:block>
                           </fo:table-cell>
                           <fo:table-cell padding-start="0pt"
                                          padding-end="4pt"
                                          padding-top="1pt"
                                          padding-bottom="1pt">
                              <fo:block>
                                 <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">String[]</fo:inline>
                              </fo:block>
                           </fo:table-cell>
                           <fo:table-cell padding-start="0pt"
                                          padding-end="4pt"
                                          padding-top="1pt"
                                          padding-bottom="1pt">
                              <fo:block>
                                 <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">{"Widget"}</fo:inline>
                              </fo:block>
                           </fo:table-cell>
                        </fo:table-row>
                        <fo:table-row keep-together.within-column="always">
                           <fo:table-cell padding-start="0pt"
                                          padding-end="4pt"
                                          padding-top="1pt"
                                          padding-bottom="1pt">
                              <fo:block>
                                 <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">com.acme.class</fo:inline>
                              </fo:block>
                           </fo:table-cell>
                           <fo:table-cell padding-start="0pt"
                                          padding-end="4pt"
                                          padding-top="1pt"
                                          padding-bottom="1pt">
                              <fo:block>
                                 <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">M</fo:inline>
                              </fo:block>
                           </fo:table-cell>
                           <fo:table-cell padding-start="0pt"
                                          padding-end="4pt"
                                          padding-top="1pt"
                                          padding-bottom="1pt">
                              <fo:block>
                                 <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">String</fo:inline>
                              </fo:block>
                           </fo:table-cell>
                           <fo:table-cell padding-start="0pt"
                                          padding-end="4pt"
                                          padding-top="1pt"
                                          padding-bottom="1pt">
                              <fo:block>
                                 <fo:block space-before.optimum="5pt"
                                           space-before.minimum="5pt"
                                           space-before.maximum="5pt">A class description of this device. For example
              "<fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                               font-size="9pt"
                                               letter-spacing="0.08em">audio</fo:inline>", "<fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                               font-size="9pt"
                                               letter-spacing="0.08em">video</fo:inline>",
              "<fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                               font-size="9pt"
                                               letter-spacing="0.08em">serial</fo:inline>", etc. An actual device category
              specification should contain an exhaustive list and define a
              process to add new classes.</fo:block>
                              </fo:block>
                           </fo:table-cell>
                        </fo:table-row>
                        <fo:table-row keep-together.within-column="always">
                           <fo:table-cell padding-start="0pt"
                                          padding-end="4pt"
                                          padding-top="1pt"
                                          padding-bottom="1pt">
                              <fo:block>
                                 <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">com.acme.model</fo:inline>
                              </fo:block>
                           </fo:table-cell>
                           <fo:table-cell padding-start="0pt"
                                          padding-end="4pt"
                                          padding-top="1pt"
                                          padding-bottom="1pt">
                              <fo:block>
                                 <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">M</fo:inline>
                              </fo:block>
                           </fo:table-cell>
                           <fo:table-cell padding-start="0pt"
                                          padding-end="4pt"
                                          padding-top="1pt"
                                          padding-bottom="1pt">
                              <fo:block>
                                 <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">String</fo:inline>
                              </fo:block>
                           </fo:table-cell>
                           <fo:table-cell padding-start="0pt"
                                          padding-end="4pt"
                                          padding-top="1pt"
                                          padding-bottom="1pt">
                              <fo:block>
                                 <fo:block space-before.optimum="5pt"
                                           space-before.minimum="5pt"
                                           space-before.maximum="5pt">A definition of the model. This is usually vendor
              specific. For example "<fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                               font-size="9pt"
                                               letter-spacing="0.08em">Mouse</fo:inline>".</fo:block>
                              </fo:block>
                           </fo:table-cell>
                        </fo:table-row>
                        <fo:table-row keep-together.within-column="always">
                           <fo:table-cell padding-start="0pt"
                                          padding-end="4pt"
                                          padding-top="1pt"
                                          padding-bottom="1pt">
                              <fo:block>
                                 <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">com.acme.manufacturer</fo:inline>
                              </fo:block>
                           </fo:table-cell>
                           <fo:table-cell padding-start="0pt"
                                          padding-end="4pt"
                                          padding-top="1pt"
                                          padding-bottom="1pt">
                              <fo:block>
                                 <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">M</fo:inline>
                              </fo:block>
                           </fo:table-cell>
                           <fo:table-cell padding-start="0pt"
                                          padding-end="4pt"
                                          padding-top="1pt"
                                          padding-bottom="1pt">
                              <fo:block>
                                 <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">String</fo:inline>
                              </fo:block>
                           </fo:table-cell>
                           <fo:table-cell padding-start="0pt"
                                          padding-end="4pt"
                                          padding-top="1pt"
                                          padding-bottom="1pt">
                              <fo:block>
                                 <fo:block space-before.optimum="5pt"
                                           space-before.minimum="5pt"
                                           space-before.maximum="5pt">Manufacturer of this device, for example "ACME
              Widget Division".</fo:block>
                              </fo:block>
                           </fo:table-cell>
                        </fo:table-row>
                        <fo:table-row keep-together.within-column="always">
                           <fo:table-cell padding-start="0pt"
